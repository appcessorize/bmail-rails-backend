<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="apple-itunes-app" content="app-id=6745029022">
  <title>Page Not Found - Blackmail.wtf</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📵</text></svg>">
  <link rel="preload" href="/fonts/WhirlyBirdie-WideBold.otf" as="font" type="font/otf" crossorigin>
  <style>
    @font-face {
      font-family: 'WhirlyBirdie';
      src: url('/fonts/WhirlyBirdie-WideBold.otf') format('opentype');
      font-weight: bold;
      font-style: normal;
      font-display: swap;
    }
    :root {
      --bm-red: #e5332a;
      --bm-blue: #4f9bc4;
      --bm-cream: #f9fafb;
      --bm-dark: #120f0e;
      --font-display: 'WhirlyBirdie', Georgia, serif;
      --font-body: 'Avenir Next', Avenir, Montserrat, Corbel, 'URW Gothic', source-sans-pro, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      background: var(--bm-dark);
      color: var(--bm-cream);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1.6;
    }
    a { text-decoration: none; }
    .wrapper {
      max-width: 520px;
      margin: 0 auto;
      padding: 1.5rem 20px;
      text-align: center;
    }
    header {
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--bm-blue);
      margin-bottom: 3rem;
    }
    header a { display: inline-block; transition: opacity 0.2s; }
    header a:hover { opacity: 0.8; }
    header img { height: 32px; width: auto; }
    .code-404 {
      font-family: var(--font-display);
      font-size: 6rem;
      font-weight: bold;
      color: var(--bm-blue);
      opacity: 0.3;
      margin-bottom: 1.5rem;
      letter-spacing: 4px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: bold;
      color: var(--bm-cream);
      margin-bottom: 1rem;
      letter-spacing: 1px;
    }
    .message {
      font-size: 1.1rem;
      color: rgba(249, 250, 251, 0.5);
      margin-bottom: 2rem;
    }
    .btn-primary {
      display: inline-block;
      background: var(--bm-red);
      color: #fff;
      padding: 1rem 2.5rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1.1rem;
      transition: transform 0.2s, box-shadow 0.2s;
      font-family: var(--font-body);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(229, 51, 42, 0.4);
    }
    footer {
      margin-top: 4rem;
      padding-top: 1.5rem;
      border-top: 2px solid var(--bm-blue);
    }
    .footer-copy {
      font-size: 0.8rem;
      color: rgba(79, 155, 196, 0.5);
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <header>
      <a href="/">
        <img src="/images/BLACKMAILShadow.png" alt="BLACKMAIL">
      </a>
    </header>

    <div class="code-404">404</div>
    <h1>Page Not Found</h1>
    <p class="message">This shame page doesn't exist.</p>
    <a href="/" class="btn-primary">Go Home</a>

    <footer>
      <p class="footer-copy">&copy; 2025 Blackmail.wtf</p>
    </footer>
  </div>
</body>
</html>
