<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="apple-itunes-app" content="app-id=6745029022">
  <title><%= @shame_visible ? "SHAME! - Blackmail.wtf" : "I'm Blackmailing Myself - Blackmail.wtf" %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📵</text></svg>">

  <!-- OG / Social share -->
  <meta property="og:title" content="<%= @shame_visible ? "SHAME! They Failed Their Focus Session — Blackmail.wtf" : "Help, I'm Being Blackmailed to Stay Off My Phone — Blackmail.wtf" %>">
  <meta property="og:description" content="<%= @shame_visible ? "This person couldn't resist picking up their phone. Their embarrassing photo is now live for everyone to see. Check it out." : "Someone is using Blackmail to stay off their phone. If they fail, their embarrassing photo goes live. Watch this page to see if they crack." %>">
  <meta property="og:image" content="<%= "#{ENV.fetch("PUBLIC_BASE_URL", request.base_url)}/images/og-share.png" %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preload" href="/fonts/WhirlyBirdie-WideBold.otf" as="font" type="font/otf" crossorigin>
  <style>
    @font-face {
      font-family: 'WhirlyBirdie';
      src: url('/fonts/WhirlyBirdie-WideBold.otf') format('opentype');
      font-weight: bold;
      font-display: swap;
    }
    :root {
      --bm-red: #e5332a;
      --bm-blue: #4f9bc4;
      --bm-cream: #f9fafb;
      --bm-dark: #120f0e;
      --font-display: 'WhirlyBirdie', Georgia, serif;
      --font-body: 'Avenir Next', Avenir, Montserrat, Corbel, 'URW Gothic', source-sans-pro, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      background: var(--bm-dark);
      color: var(--bm-cream);
      min-height: 100vh;
      line-height: 1.7;
    }
    a { color: var(--bm-blue); text-decoration: none; }
    a:hover { opacity: 0.8; }

    /* Header */
    .site-header {
      max-width: 600px; margin: 0 auto; padding: 20px 20px;
      display: flex; justify-content: space-between; align-items: center;
      background: var(--bm-cream);
    }
    .site-header img { height: 28px; }
    .faq-link { color: var(--bm-dark); font-weight: 600; font-size: 0.9rem; opacity: 0.5; }

    /* Hero */
    .hero {
      text-align: center; padding: 60px 20px 40px; max-width: 100%; margin: 0 auto;
      background: var(--bm-cream); color: var(--bm-dark);
    }
    .hero-inner { max-width: 600px; margin: 0 auto; }
    .hero h1 {
      font-family: var(--font-display);
      font-weight: bold;
      line-height: 1.1;
      letter-spacing: 2px;
      margin-bottom: 1.25rem;
      font-size: clamp(1.5rem, 7vw, 2.8rem);
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .hero h1.shame { color: var(--bm-red); }
    .hero h1.focus { color: var(--bm-dark); letter-spacing: 1px; font-family: 'Avenir Next', 'AvenirNext-Bold', sans-serif; font-size: clamp(1.4rem, 5vw, 2.2rem); text-transform: uppercase; }
    .hero .lead { color: rgba(18,15,14,0.6); }
    .hero .lead {
      font-size: 1.1rem;
      color: rgba(249,250,251,0.65);
      max-width: 400px;
      margin: 0 auto;
    }
    .status-badge {
      display: inline-block; padding: 6px 18px; border-radius: 99px;
      font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 2px; margin-bottom: 1.5rem;
      background: var(--bm-red); color: #fff;
    }
    .time-ago {
      font-size: 0.85rem; color: rgba(249,250,251,0.4); margin-top: 1rem;
    }

    /* Shame image */
    .shame-image-wrapper {
      width: 100%; max-width: 360px; margin: 2rem auto 0; position: relative;
      border-radius: 16px; overflow: hidden; aspect-ratio: 3/4;
      background: linear-gradient(110deg, #e0e0e0 8%, #f0f0f0 18%, #e0e0e0 33%);
      background-size: 200% 100%;
      animation: shimmer 1.5s linear infinite;
    }
    @keyframes shimmer {
      to { background-position: -200% 0; }
    }
    .shame-image {
      width: 100%; display: block; border-radius: 16px;
      position: relative; z-index: 1;
    }
    .shame-image-wrapper.loaded {
      background: none; animation: none; aspect-ratio: auto;
    }

    /* Blur box */
    .blur-box {
      position: relative; width: 100%; max-width: 340px;
      margin: 2rem auto 0; aspect-ratio: 1; border-radius: 16px;
      border: 3px solid rgba(18, 15, 14, 0.1); overflow: hidden;
    }
    .blur-bg {
      position: absolute; inset: -20px; filter: blur(30px);
      background:
        radial-gradient(circle at 30% 40%, rgba(229,51,42,0.4) 0%, transparent 50%),
        radial-gradient(circle at 70% 60%, rgba(79,155,196,0.35) 0%, transparent 50%),
        radial-gradient(circle at 50% 30%, rgba(255,191,217,0.3) 0%, transparent 40%),
        linear-gradient(160deg, #2a1f1e 0%, #1a2a33 50%, #2a1f1e 100%);
      animation: blurShift 6s ease-in-out infinite alternate;
    }
    @keyframes blurShift {
      0% { filter: blur(30px) brightness(0.9); }
      100% { filter: blur(35px) brightness(1.1); }
    }
    .blur-text {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 2rem;
      font-weight: 600; font-size: 1.05rem; line-height: 1.6; text-align: center;
    }
    .blur-text .camera-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
    .blur-email-form { margin-top: 1.25rem; width: 100%; max-width: 240px; }
    .blur-email-form input {
      width: 100%; padding: 0.55rem 0.75rem; border-radius: 8px;
      border: 1.5px solid rgba(79,155,196,0.4); background: rgba(255,255,255,0.8);
      color: var(--bm-dark); font-size: 0.85rem; font-family: var(--font-body);
      margin-bottom: 0.4rem; text-align: center;
    }
    .blur-email-form input:focus { outline: none; border-color: var(--bm-blue); }
    .blur-email-form input::placeholder { color: rgba(18,15,14,0.3); }
    .blur-email-form button {
      width: 100%; padding: 0.55rem; border-radius: 8px; border: none;
      background: var(--bm-blue); color: #fff; font-weight: 700;
      font-size: 0.85rem; cursor: pointer; font-family: var(--font-body);
    }

    /* Sections */
    .section { max-width: 600px; margin: 0 auto; padding: 40px 20px; }
    .section-divider { border: none; border-top: 1px solid rgba(79,155,196,0.15); margin: 0; }

    /* Explain */
    .explain-toggle {
      background: none; border: none; color: var(--bm-blue); cursor: pointer;
      font-size: 0.95rem; font-weight: 600; font-family: var(--font-body);
      padding: 0; transition: opacity 0.2s;
    }
    .explain-toggle:hover { opacity: 0.7; }
    .explain-content {
      display: none; margin-top: 1.5rem;
      font-size: 1rem; line-height: 1.8; color: rgba(249,250,251,0.7);
    }
    .explain-content.open { display: block; }
    .explain-content ol { margin: 0.75rem 0 0 1.25rem; }
    .explain-content li { margin-bottom: 0.5rem; }

    /* Notify */
    .notify-heading {
      font-family: var(--font-display); color: var(--bm-blue);
      font-size: 1.2rem; letter-spacing: 1px; margin-bottom: 0.4rem;
    }
    .notify-sub { font-size: 0.9rem; color: rgba(249,250,251,0.5); margin-bottom: 1.25rem; }
    .notify-form { display: flex; gap: 0.5rem; }
    .notify-form input {
      flex: 1; padding: 0.75rem 1rem; border-radius: 8px;
      border: 1.5px solid rgba(79,155,196,0.25); background: rgba(255,255,255,0.04);
      color: var(--bm-cream); font-size: 0.95rem; font-family: var(--font-body);
    }
    .notify-form input:focus { outline: none; border-color: var(--bm-blue); }
    .notify-form input::placeholder { color: rgba(249,250,251,0.25); }
    .notify-form button {
      padding: 0.75rem 1.5rem; border-radius: 8px; border: none;
      background: var(--bm-blue); color: #fff; font-weight: 700;
      font-size: 0.95rem; cursor: pointer; font-family: var(--font-body);
      white-space: nowrap; transition: transform 0.2s;
    }
    .notify-form button:hover { transform: translateY(-1px); }
    .notify-form button:disabled { opacity: 0.5; cursor: default; transform: none; }
    .notify-success { color: #22c55e; font-weight: 600; font-size: 0.95rem; }
    .notify-error { color: var(--bm-red); font-size: 0.85rem; margin-top: 0.5rem; }

    /* Share buttons */
    .share-heading { font-size: 0.85rem; color: rgba(249,250,251,0.4); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
    .share-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .share-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.7rem 1.2rem; border-radius: 8px; border: none;
      font-weight: 600; font-size: 0.9rem; font-family: var(--font-body);
      cursor: pointer; transition: transform 0.2s; color: #fff; text-decoration: none;
    }
    .share-btn:hover { transform: translateY(-1px); }
    .share-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
    .share-btn.primary { background: var(--bm-blue); }
    .share-btn.copy { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); }
    .share-btn.copy.copied { background: #22c55e; border-color: #22c55e; }
    .share-btn.whatsapp { background: #25d366; }

    /* Download */
    .download-cta { text-align: center; padding: 50px 20px; }
    .download-cta p {
      font-size: 1.15rem; font-weight: 700; color: var(--bm-cream); margin-bottom: 1.25rem;
    }
    .download-cta .app-badge { height: 48px; transition: transform 0.2s; }
    .download-cta .app-badge:hover { transform: translateY(-2px); }

    /* Report */
    .report-link {
      font-size: 0.8rem; color: rgba(249,250,251,0.3); transition: color 0.2s;
    }
    .report-link:hover { color: var(--bm-red); }

    /* Footer */
    footer {
      background: var(--bm-dark); color: var(--bm-cream);
      padding: 2.5rem 20px; text-align: center;
    }
    footer .footer-inner { max-width: 600px; margin: 0 auto; }
    .footer-quote { font-style: italic; color: var(--bm-blue); font-size: 0.9rem; margin-bottom: 0.75rem; }
    .footer-links { font-size: 0.8rem; }
    .footer-links a { color: rgba(249,250,251,0.4); margin: 0 0.5rem; }
    .footer-links a:hover { color: var(--bm-cream); }

    /* Modals */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.85); z-index: 50;
      align-items: center; justify-content: center; padding: 1rem;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: var(--bm-dark); border: 2px solid var(--bm-blue);
      border-radius: 16px; max-width: 500px; width: 100%;
      max-height: 80vh; overflow-y: auto;
    }
    .modal-header {
      position: sticky; top: 0; background: var(--bm-dark);
      border-bottom: 1px solid rgba(79,155,196,0.2);
      padding: 1rem 1.5rem; display: flex;
      justify-content: space-between; align-items: center;
    }
    .modal-header h2 { font-family: var(--font-display); color: var(--bm-blue); font-size: 1.2rem; letter-spacing: 1px; }
    .modal-close { background: none; border: none; color: var(--bm-cream); font-size: 1.8rem; cursor: pointer; line-height: 1; }
    .modal-body { padding: 1.5rem; }
    .modal-body .faq-item { margin-bottom: 1.5rem; }
    .modal-body .faq-item h3 { font-family: var(--font-display); color: var(--bm-red); font-size: 1rem; margin-bottom: 0.4rem; }
    .modal-body .faq-item p { color: rgba(249,250,251,0.75); font-size: 0.9rem; line-height: 1.6; }

    /* Report modal */
    .report-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 100; align-items: center; justify-content: center; padding: 1rem; }
    .report-modal.open { display: flex; }
    .report-card { background: var(--bm-dark); border: 2px solid var(--bm-red); border-radius: 16px; max-width: 420px; width: 100%; padding: 1.5rem; }
    .report-card h3 { font-family: var(--font-display); color: var(--bm-red); font-size: 1.2rem; margin-bottom: 1rem; }
    .report-card label { display: block; color: var(--bm-cream); font-size: 0.9rem; margin-bottom: 0.5rem; font-weight: 600; }
    .report-card select, .report-card textarea { width: 100%; padding: 0.75rem; border: 1.5px solid rgba(229,51,42,0.3); border-radius: 8px; background: rgba(0,0,0,0.4); color: var(--bm-cream); font-size: 0.95rem; font-family: var(--font-body); margin-bottom: 1rem; }
    .report-card select:focus, .report-card textarea:focus { outline: none; border-color: var(--bm-red); }
    .report-card textarea { min-height: 80px; resize: vertical; }
    .report-actions { display: flex; gap: 0.75rem; }
    .report-actions button { flex: 1; padding: 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem; cursor: pointer; border: none; font-family: var(--font-body); }
    .btn-report-cancel { background: rgba(249,250,251,0.1); color: var(--bm-cream); }
    .btn-report-submit { background: var(--bm-red); color: #fff; }
    .report-success { text-align: center; color: #22c55e; font-weight: 600; padding: 1rem 0; }

    @media (max-width: 480px) {
      .hero { padding: 40px 20px 30px; }
      .notify-form { flex-direction: column; }
      .share-row { flex-direction: column; }
    }
  </style>
  <script defer src="https://umamipod.pikapod.net/script.js" data-website-id="5d73ff14-c500-44db-a236-a3b74598c018"></script>
</head>
<body>

  <div style="background: var(--bm-cream);">
    <header class="site-header">
      <a href="/"><img src="/images/BLACKMAILLogoLight.svg" alt="BLACKMAIL"></a>
      <a href="#" class="faq-link" onclick="openFaqModal(); return false;">FAQ</a>
    </header>
  </div>

  <% if @shame_visible %>
    <!-- SHAME STATE -->
    <div class="hero">
      <div class="hero-inner">
        <div><span class="status-badge">FAILED</span></div>
        <h1 class="shame">THEY COULDN'T<br>RESIST</h1>
        <p class="lead">This person failed their focus session. Their embarrassing photo is now public.</p>

        <% if @has_image %>
          <div class="shame-image-wrapper" id="shameImageWrapper">
            <img src="<%= shame_page_image_path(@user.page_slug) %>" alt="Shame Photo" class="shame-image" onload="document.getElementById('shameImageWrapper').classList.add('loaded')">
          </div>
        <% end %>

        <% if @shame_activated_at %>
          <p class="time-ago" style="color: rgba(18,15,14,0.4);">Failed <%= time_ago_in_words(@shame_activated_at) %> ago</p>
        <% end %>

        <div style="margin-top: 2rem;">
          <p class="share-heading" style="color: rgba(18,15,14,0.4);">Share this page</p>
          <div class="share-row" style="justify-content: center;">
            <button class="share-btn primary" onclick="shareNative()">Share</button>
            <button class="share-btn copy" id="copyBtn" onclick="copyLink()" style="background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.1); color: var(--bm-dark);"><span id="copyText">Copy Link</span></button>
            <a class="share-btn whatsapp" href="https://wa.me/?text=<%= CGI.escape("Check if they failed: #{request.original_url}") %>" target="_blank">WhatsApp</a>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <!-- FOCUSED STATE -->
    <div class="hero">
      <div class="hero-inner">
      <h1 class="focus">I'M BLACKMAILING MYSELF</h1>
      <p class="lead">If I use my phone too much, an embarrassing picture will appear here.</p>

      <div class="blur-box">
        <div class="blur-bg"></div>
        <div class="blur-text">
          <p><span class="camera-icon">📸</span>Photo will appear here if they pick up their phone</p>
          <div class="blur-email-form" id="blurEmailWrapper">
            <input type="email" id="blurWatchEmail" placeholder="your@email.com" autocomplete="email">
            <button onclick="submitBlurWatch()" id="blurWatchBtn">Notify Me</button>
          </div>
          <div id="blurWatchSuccess" style="display:none; margin-top:1rem; color:#22c55e; font-size:0.85rem; font-weight:600;"></div>
        </div>
      </div>

      <div style="margin-top: 2rem;">
        <p class="share-heading" style="color: rgba(18,15,14,0.4);">Share this page</p>
        <div class="share-row" style="justify-content: center;">
          <button class="share-btn primary" onclick="shareNative()">Share</button>
          <button class="share-btn copy" id="copyBtn2" onclick="copyLink()" style="background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.1); color: var(--bm-dark);"><span id="copyText2">Copy Link</span></button>
          <a class="share-btn whatsapp" href="https://wa.me/?text=<%= CGI.escape("Check if they failed: #{request.original_url}") %>" target="_blank">WhatsApp</a>
        </div>
      </div>
      </div>
    </div>

    <hr class="section-divider">

    <div class="section">
      <button class="explain-toggle" id="explainToggle" onclick="toggleExplain()">How does this work? ▾</button>
      <div class="explain-content" id="explainContent">
        <p><strong>Blackmail</strong> is an app that uses the power of shame to help you stay off your phone.</p>
        <p style="margin-top:0.75rem;">Here's how it works:</p>
        <ol>
          <li>They uploaded an embarrassing photo of themselves</li>
          <li>They shared this page with friends (that's you!)</li>
          <li>They start a focus timer and put their phone face-down</li>
          <li>If they pick up their phone before the timer ends, their embarrassing photo appears on this page for everyone to see</li>
        </ol>
        <p style="margin-top:0.75rem; color: var(--bm-blue); font-weight: 600;">The fear of public embarrassment keeps them focused.</p>
      </div>
    </div>
  <% end %>

  <hr class="section-divider">

  <!-- Get Updates -->
  <div class="section" id="notifySection">
    <h3 class="notify-heading">Get Updates</h3>
    <p class="notify-sub">We'll email you the moment this page changes.</p>
    <div id="notifyFormWrapper">
      <div class="notify-form" id="notifyForm">
        <input type="email" id="watchEmail" placeholder="your@email.com" autocomplete="email">
        <button id="watchBtn" onclick="submitWatch()">Notify Me</button>
      </div>
      <div id="watchError" class="notify-error" style="display:none;"></div>
    </div>
    <div id="notifySuccess" class="notify-success" style="display:none;"></div>
  </div>

  <div style="text-align:center; padding: 2.5rem 0 1.5rem;">
    <a href="https://apps.apple.com/app/blackmail-focus-or-else/id6745029022" target="_blank" rel="noopener">
      <img src="/images/appstorebadgeblack.svg" alt="Download on the App Store" style="height:48px;">
    </a>
  </div>

  <div style="text-align:center; padding-bottom: 2rem;">
    <a href="#" class="report-link" onclick="openReportModal(); return false;">Report Content</a>
  </div>

  <footer>
    <div class="footer-inner">
      <p class="footer-quote">"On your deathbed, will you regret not using your phone more?"</p>
      <div class="footer-links">
        <a href="mailto:support@blackmail.wtf">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </footer>

  <!-- FAQ Modal -->
  <div class="modal-overlay" id="faqModal">
    <div class="modal">
      <div class="modal-header">
        <h2>FAQ</h2>
        <button class="modal-close" onclick="closeFaqModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="faq-item"><h3>What is this page?</h3><p>This is a public shame page for someone using the Blackmail app. When they fail a focus session by picking up their phone, their embarrassing photo appears here.</p></div>
        <div class="faq-item"><h3>How does Blackmail work?</h3><p>Users upload an embarrassing photo and set a focus timer. If they pick up their phone before the timer ends, their photo becomes visible on their public shame page.</p></div>
        <div class="faq-item"><h3>Why would someone do this?</h3><p>The fear of public embarrassment is a powerful motivator. By sharing this page with friends, users create real accountability to stay focused and off their phones.</p></div>
        <div class="faq-item"><h3>Can they hide their photo?</h3><p>Yes! Users can hide their shame photo anytime from the app settings. But until they do, it stays visible to anyone with this link.</p></div>
        <div class="faq-item"><h3>Is this page public?</h3><p>The page URL is a random code that's impossible to guess. Only people who have been shared the link can see it.</p></div>
      </div>
    </div>
  </div>

  <!-- Report Modal -->
  <div class="report-modal" id="reportModal">
    <div class="report-card">
      <div id="reportForm">
        <h3>Report Content</h3>
        <label for="reportReason">Reason</label>
        <select id="reportReason">
          <option value="">Select a reason...</option>
          <option value="inappropriate">Inappropriate or offensive content</option>
          <option value="illegal">Illegal content</option>
          <option value="harassment">Harassment or bullying</option>
          <option value="other">Other</option>
        </select>
        <label for="reportDetails">Details (optional)</label>
        <textarea id="reportDetails" placeholder="Provide additional details..."></textarea>
        <div class="report-actions">
          <button class="btn-report-cancel" onclick="closeReportModal()">Cancel</button>
          <button class="btn-report-submit" id="reportSubmitBtn" onclick="submitReport()">Submit</button>
        </div>
      </div>
      <div id="reportSuccess" class="report-success" style="display:none;">
        <p>Thank you. We'll review this shortly.</p>
        <button class="btn-report-cancel" onclick="closeReportModal()" style="margin-top:1rem;width:100%;">Close</button>
      </div>
    </div>
  </div>

  <script>
    function toggleExplain() {
      var el = document.getElementById('explainContent');
      var btn = document.getElementById('explainToggle');
      el.classList.toggle('open');
      btn.textContent = el.classList.contains('open') ? 'How does this work? ▴' : 'How does this work? ▾';
    }

    function submitBlurWatch() {
      var email = document.getElementById('blurWatchEmail').value.trim();
      if (!email || !email.includes('@')) return;
      var btn = document.getElementById('blurWatchBtn');
      btn.disabled = true; btn.textContent = '...';
      var fd = new FormData(); fd.append('email', email);
      fetch('<%= shame_page_watch_path(@user.page_slug) %>', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        document.getElementById('blurEmailWrapper').style.display = 'none';
        var s = document.getElementById('blurWatchSuccess');
        s.textContent = d.message || "You'll be notified!"; s.style.display = '';
        document.getElementById('notifyFormWrapper').style.display = 'none';
        var ls = document.getElementById('notifySuccess');
        ls.textContent = d.message || "You'll be notified!"; ls.style.display = '';
      })
      .catch(function() { btn.disabled = false; btn.textContent = 'Notify Me'; });
    }

    function submitWatch() {
      var email = document.getElementById('watchEmail').value.trim();
      var err = document.getElementById('watchError');
      err.style.display = 'none';
      if (!email || !email.includes('@')) { err.textContent = 'Please enter a valid email.'; err.style.display = ''; return; }
      var btn = document.getElementById('watchBtn');
      btn.disabled = true; btn.textContent = 'Subscribing...';
      var fd = new FormData(); fd.append('email', email);
      fetch('<%= shame_page_watch_path(@user.page_slug) %>', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        document.getElementById('notifyFormWrapper').style.display = 'none';
        var s = document.getElementById('notifySuccess');
        s.textContent = d.message || "You'll be notified when this page changes."; s.style.display = '';
      })
      .catch(function() { err.textContent = 'Something went wrong.'; err.style.display = ''; btn.disabled = false; btn.textContent = 'Notify Me'; });
    }

    function openReportModal() { document.getElementById('reportModal').classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeReportModal() { document.getElementById('reportModal').classList.remove('open'); document.body.style.overflow = ''; document.getElementById('reportForm').style.display = ''; document.getElementById('reportSuccess').style.display = 'none'; document.getElementById('reportReason').value = ''; document.getElementById('reportDetails').value = ''; }
    document.getElementById('reportModal').addEventListener('click', function(e) { if (e.target === this) closeReportModal(); });
    function submitReport() {
      var reason = document.getElementById('reportReason').value; if (!reason) return;
      var btn = document.getElementById('reportSubmitBtn'); btn.disabled = true; btn.textContent = '...';
      var fd = new FormData(); fd.append('reason', reason); fd.append('details', document.getElementById('reportDetails').value);
      fetch('<%= shame_page_report_path(@user.page_slug) %>', { method: 'POST', body: fd })
      .then(function() { document.getElementById('reportForm').style.display = 'none'; document.getElementById('reportSuccess').style.display = ''; })
      .catch(function() { btn.disabled = false; btn.textContent = 'Submit'; });
    }

    function openFaqModal() { document.getElementById('faqModal').classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeFaqModal() { document.getElementById('faqModal').classList.remove('open'); document.body.style.overflow = ''; }
    document.getElementById('faqModal').addEventListener('click', function(e) { if (e.target === this) closeFaqModal(); });

    function shareNative() {
      if (navigator.share) {
        navigator.share({ title: '<%= @shame_visible ? "SHAME! They failed!" : "Help, I\\'m being blackmailed!" %>', text: '<%= @shame_visible ? "They couldn\\'t resist their phone!" : "Someone is blackmailing themselves to stay off their phone" %>', url: window.location.href }).catch(console.error);
      } else { copyLink(); }
    }
    function copyLink() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        var btn = document.getElementById('copyBtn'), text = document.getElementById('copyText');
        text.textContent = 'Copied!'; btn.classList.add('copied');
        setTimeout(function() { text.textContent = 'Copy Link'; btn.classList.remove('copied'); }, 2000);
      });
    }
  </script>
</body>
</html>
